# tools/setup.py creates .env with a random password. Keep it private.
APP_PASSWORD=
PUBLIC_URL=http://127.0.0.1:8080
DEFAULT_PROVIDER=openai
# Keys remain server-side. Choose exact model IDs your account can access.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: official caption import for videos the authorized user can edit.
# Required OAuth scope: https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
